# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# --- Postgres (via Prisma) ---
DATABASE_URL="postgresql://scheduler:scheduler@localhost:5432/email_scheduler?schema=public"

# --- Redis (BullMQ) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Elasticsearch (search over scheduled/sent emails) ---
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# --- BullMQ / worker tuning ---
WORKER_CONCURRENCY=5
# Fallback global cap used only when a sender has no explicit maxEmailsPerHour
MAX_EMAILS_PER_HOUR=200

# --- Bull Board (live queue dashboard) ---
BULLBOARD_PATH=/admin/queues
BULLBOARD_USER=admin
BULLBOARD_PASSWORD=admin

# --- Google OAuth login ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Slack OAuth (rate-limit notifications) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/auth/slack/callback

# --- Ethereal senders ---
# JSON array of sender mailboxes used round-robin to send mail.
# Generate real Ethereal test accounts with `npm run ethereal:create`
# and paste the printed JSON here (or run `npm run seed:senders`).
# Example:
# SENDERS_JSON=[{"name":"Sender One","email":"abc@ethereal.email","smtpHost":"smtp.ethereal.email","smtpPort":587,"smtpUser":"abc@ethereal.email","smtpPass":"secret","maxEmailsPerHour":100}]
SENDERS_JSON=[]
